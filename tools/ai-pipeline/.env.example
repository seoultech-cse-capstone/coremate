AI_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_REVIEW_MODEL=gpt-5.4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_REVIEW_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

COREMATE_MYSQL_HOST=127.0.0.1
COREMATE_MYSQL_PORT=3306
COREMATE_MYSQL_DATABASE=coremate
COREMATE_MYSQL_USER=coremate
# 비밀번호는 여기 적지 않는다. infra/.env 의 MYSQL_PASSWORD 를 자동으로 가져다 쓴다.
# (도커 컴포즈가 만드는 DB 계정과 같은 값이어야 해서 출처를 한 곳으로 모았다.)
COREMATE_MYSQL_CHARSET=utf8mb4
