# infra/.env 예시.
#
# 팀에서 공유하는 infra/.env 파일을 받아 이 위치에 두면 됩니다(git 미추적).
#   coremate/infra/.env
# 공유본이 없으면 이 파일을 복사해 직접 만들어도 됩니다.
#   cp infra/.env.example infra/.env
#
# 이 값들은 docker-compose.local.yml 과 백엔드(application.yaml)가 함께 사용합니다.
# .env 가 없어도 개발용 기본값으로 동작하지만, 팀 공유본을 쓰는 것을 권장합니다.
#
# 주의: 실제 비밀번호를 git 에 커밋하지 마세요.

# MySQL (없으면 기본값 root / coremate 사용)
#   생성 예시: LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32; echo
MYSQL_ROOT_PASSWORD=change-me-random-32-chars
MYSQL_PASSWORD=change-me-random-32-chars

# JWT
#   생성 예시: openssl rand -base64 48
JWT_SECRET=your-base64-encoded-secret-key-here
